{
  "schema": 1,
  "id": "io.github.skingko.pastai.open-link",
  "version": "1.0.0",
  "author": "PastAi",
  "name": {
    "en": "Open Link",
    "zh": "打开链接"
  },
  "description": {
    "en": "Open the selected web address.",
    "zh": "打开选中的网址。"
  },
  "category": "web",
  "regions": [
    "global"
  ],
  "icon": "symbol:safari",
  "match": {
    "regex": "^https?://\\S+$",
    "maxLength": 4000
  },
  "action": {
    "type": "url",
    "url": "{text.raw}"
  }
}
