{
  "schema": 1,
  "id": "io.github.skingko.pastai.whatsapp",
  "version": "1.1.0",
  "author": "PastAi",
  "name": {
    "en": "WhatsApp",
    "zh": "WhatsApp"
  },
  "description": {
    "en": "Send the selection through WhatsApp: pick a contact there, or set one to go straight to.",
    "zh": "通过 WhatsApp 发送选中内容：在 WhatsApp 里选择联系人，也可以固定一个联系人直接发送。"
  },
  "category": "social",
  "regions": [
    "us"
  ],
  "icon": "file:icon.svg",
  "match": {
    "maxLength": 4000
  },
  "options": [
    {
      "id": "phone",
      "type": "string",
      "label": {
        "en": "Always send to (optional)",
        "zh": "固定发给（可选）"
      },
      "placeholder": {
        "en": "Leave empty to pick a contact each time",
        "zh": "留空则每次选择联系人；固定时填国家码加号码"
      }
    },
    {
      "id": "autoSend",
      "type": "boolean",
      "label": {
        "en": "Send automatically to that contact",
        "zh": "发给固定联系人时自动发送"
      },
      "defaultValue": "false"
    }
  ],
  "action": {
    "type": "url",
    "url": "whatsapp://send?phone={option.phone}&text={text}",
    "fallbackURL": "https://wa.me/{option.phone}?text={text}",
    "returnKeyOption": "autoSend"
  }
}
